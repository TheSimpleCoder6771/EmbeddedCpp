    "version": "0.2.0",
    "configurations": [
    {
      "name": "Debug WB55 (OpenOCD)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",

      "executable": "${workspaceFolder}/build-wb55/app.elf",

      "configFiles": [
        "${workspaceFolder}/openocd_wb55.cfg"
      ],

      "gdbPath": "arm-none-eabi-gdb",

      "runToEntryPoint": "main",
      "svdFile": "${workspaceFolder}/STM32WB55_CM4.svd",
      "preLaunchTask": "Flash WB55 (OpenOCD)"
    }
  ]
}